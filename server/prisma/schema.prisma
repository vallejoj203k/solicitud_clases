// Esquema de datos de la app de reservas.
//
// Decision de diseno importante: NO existe una tabla `Puesto` materializada.
// El mapa de puestos vive como JSON en `TipoClase.layoutPuestos` (o en
// `Clase.layoutOverride` si una clase puntual usa otro salon) y la ocupacion se
// deriva de las reservas activas. Esto evita duplicar el estado "ocupado" en dos
// lugares -que es la fuente clasica de inconsistencias- y evita generar N filas
// por cada clase creada. Ver `services/disponibilidad.service.js`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CLIENTE
  ADMIN
}

enum EstadoClase {
  ACTIVA
  CANCELADA
}

enum EstadoReserva {
  // Aparta el puesto mientras la persona paga en linea. Si no paga, expira.
  PENDIENTE_PAGO
  CONFIRMADA
  CANCELADA
  // El plazo para pagar se vencio y el puesto volvio a quedar libre.
  EXPIRADA
  ASISTIO
  NO_SHOW
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  RECHAZADO
}

enum EstadoPedidoMusica {
  EN_FILA
  SONANDO
  SONO
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  // Opcional: el gimnasio no le pide el numero a nadie. Cuando lo hay sirve
  // para reconocer a quien ya reservo antes; cuando no, cada reserva crea su
  // propia persona y no hay forma de que dos desconocidos se fundan en una.
  //
  // Sigue siendo unico -en Postgres varios NULL no chocan-, asi que impide dos
  // cuentas con el mismo numero sin estorbar a las que no tienen ninguno. Los
  // admin si necesitan uno para entrar, pero eso lo exige la aplicacion.
  telefono     String?  @unique
  email        String?
  rol          Rol      @default(CLIENTE)
  // Solo los admin tienen password. Los clientes no inician sesion.
  passwordHash String?
  notas        String?
  // Momento en que la persona autorizo el tratamiento de sus datos
  // (Ley 1581 de 2012). Null = todavia no lo ha hecho.
  aceptoDatosEn DateTime?
  creadoEn     DateTime @default(now())

  reservas      Reserva[]
  pedidosMusica PedidoMusica[]

  @@index([nombre])
  @@index([rol])
}

model TipoClase {
  id          String  @id @default(cuid())
  slug        String  @unique // "running" | "spinning"
  nombre      String
  descripcion String
  // Color de acento en hex, lo consume el frontend para diferenciar la disciplina.
  color       String  @default("#C8F751")
  icono       String  @default("run")
  // Estructura del mapa de puestos. Ver docs/layout en el README.
  // { titulo, filas: [{ label, puestos, offset? }], pasilloDespuesDeCol?, numeracion }
  layoutPuestos Json
  precioCop   Int     @default(0)
  orden       Int     @default(0)
  activo      Boolean @default(true)

  clases Clase[]
}

model Instructor {
  id     String  @id @default(cuid())
  nombre String
  foto   String?
  activo Boolean @default(true)

  clases Clase[]
}

model Clase {
  id          String @id @default(cuid())
  tipoClaseId String
  tipoClase   TipoClase @relation(fields: [tipoClaseId], references: [id], onDelete: Restrict)

  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  // Instante de inicio en UTC. El gimnasio opera en America/Bogota (UTC-5 fijo,
  // sin horario de verano), la conversion se hace en `utils/fechas.js`.
  inicioEn    DateTime
  duracionMin Int      @default(50)

  // Cupo maximo real de la clase. Puede ser menor que el total de puestos del
  // layout (ej. salon de 20 bicis pero solo se abren 16).
  cupoMaximo  Int
  precioCop   Int      @default(0)

  // Si la clase se dicta en un salon distinto al habitual del tipo de clase.
  layoutOverride    Json?
  // Puestos fuera de servicio SOLO para esta clase (ej. ["B3"] bici danada).
  puestosBloqueados String[] @default([])

  estado   EstadoClase @default(ACTIVA)
  notas    String?
  creadoEn DateTime    @default(now())

  reservas      Reserva[]
  pedidosMusica PedidoMusica[]

  @@index([inicioEn])
  @@index([tipoClaseId, inicioEn])
  @@index([estado, inicioEn])
}

model Reserva {
  id     String @id @default(cuid())
  // Codigo corto legible para el check-in en recepcion / QR (ej. "K7QF2M").
  codigo String @unique

  claseId String
  clase   Clase  @relation(fields: [claseId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Codigo del puesto dentro del layout, ej. "A1", "B4".
  puestoCodigo String

  estado     EstadoReserva @default(CONFIRMADA)

  // --- Bloque de pago -------------------------------------------------------
  // Hoy el admin marca el pago a mano. Los campos `metodoPago` / `pagoRef` /
  // `pagoPayload` ya estan listos para guardar la respuesta de una pasarela
  // (Wompi, Stripe) sin cambiar el modelo. Ver `services/pago.service.js`.
  estadoPago        EstadoPago @default(PENDIENTE)
  montoCop          Int        @default(0)
  metodoPago        String? // "efectivo" | "transferencia" | "wompi" | "stripe"
  pagoRef           String? // id de la transaccion en la pasarela
  pagoPayload       Json?
  pagoActualizadoEn DateTime?
  // Anotacion para recepcion cuando el pago necesita atencion humana, p. ej.
  // un pago que entro despues de que el puesto ya se habia liberado.
  notasPago         String?

  // Hasta cuando se le guarda el puesto a quien esta pagando. Null en las
  // reservas que no pasaron por la pasarela.
  expiraEn    DateTime?

  // Cuando el cliente dijo "ya transferi". Solo aplica al cobro por
  // transferencia, donde no hay pasarela que avise: es lo que pone la reserva
  // en la cola de recepcion para que alguien coteje y confirme.
  avisoPagoEn DateTime?

  // Para quien es el puesto, cuando no es para quien reserva: una pareja va
  // junta y paga una sola persona. Sin esto recepcion veria el mismo nombre
  // dos veces y no sabria a quien esta recibiendo.
  nombreInvitado String?

  creadoEn    DateTime  @default(now())
  canceladoEn DateTime?

  @@index([claseId, estado])
  @@index([estado, expiraEn])
  @@index([estado, avisoPagoEn])
  @@index([usuarioId, creadoEn])
  @@index([estadoPago])
  @@index([creadoEn])
}

// Busquedas de YouTube ya hechas, para no volver a pagarlas.
//
// La cuota gratuita da 10.000 unidades al dia y una busqueda cuesta 100: unas
// cien diarias para todo el gimnasio. Habia cache, pero vivia en un Map del
// proceso y cada despliegue de Railway la vaciaba, asi que casi nunca servia.
//
// El TTL es largo a proposito: los resultados de "bad bunny" no cambian de un
// dia para otro, y repetir una busqueda ya hecha no tiene por que costar cuota
// nunca mas. Ver `HORAS_CACHE_BUSQUEDA` en youtube.service.js.
model BusquedaYoutube {
  id String @id @default(cuid())
  // Normalizado: minusculas y sin espacios de mas.
  texto     String   @unique
  resultado Json
  creadoEn  DateTime @default(now())

  @@index([creadoEn])
}

// Catalogo de musica.
//
// LA APP NO ALOJA AUDIO. Guarda el id del video de YouTube y lo reproduce con
// el reproductor incrustado oficial, que va con su publicidad y sus reglas. Lo
// que se guarda aqui es lo justo para pintar la fila sin volver a preguntarle a
// YouTube en cada carga: titulo, canal, duracion y miniatura.
//
// Las filas sin `videoId` son del catalogo de texto anterior: siguen sirviendo
// para que el instructor las ponga a mano, pero el reproductor las salta.
model Cancion {
  id      String  @id @default(cuid())
  titulo  String
  artista String?

  // Identificador del video en YouTube (11 caracteres). Unico: dos personas que
  // eligen la misma cancion apuntan a la misma fila.
  videoId     String? @unique
  canal       String?
  duracionSeg Int?
  miniatura   String?

  // Momento de la clase al que le va ("calentamiento", "subida", "pico",
  // "enfriamiento"). Opcional; ayuda al instructor a encajar los pedidos.
  momento String?
  // Las que pone el gimnasio cuando nadie pide nada.
  deLaCasa Boolean  @default(false)
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now())

  // Cuando el reproductor incrustado se nego a ponerla. La API de datos dice
  // que muchos videos se dejan incrustar y luego no: es el caso tipico de los
  // sellos grandes. No se puede saber por adelantado, asi que se aprende de la
  // primera vez y no se vuelve a proponer ni a dejar pedir.
  bloqueadaEn DateTime?

  pedidos PedidoMusica[]

  // Evita duplicados al pegar la lista dos veces.
  @@unique([titulo, artista])
  @@index([activa, titulo])
  @@index([deLaCasa, activa])
  @@index([bloqueadaEn])
}

// Una cancion pedida por alguien para una clase concreta.
// Una cancion pedida para los parlantes del gimnasio.
//
// LA COLA ES UNA SOLA, no una por clase: hay un unico reproductor y pedir no
// exige tener reserva. Por eso `claseId` y `usuarioId` son opcionales.
//
//  - `claseId` queda para saber en que clase se pidio, si habia alguna. No
//    filtra nada; es historial.
//  - `usuarioId` esta cuando el telefono ya tiene sesion de cliente (la recibio
//    al reservar alguna vez). Si no, el pedido es anonimo.
model PedidoMusica {
  id String @id @default(cuid())

  claseId String?
  clase   Clase?  @relation(fields: [claseId], references: [id], onDelete: SetNull)

  cancionId String
  cancion   Cancion @relation(fields: [cancionId], references: [id], onDelete: Cascade)

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  // Identificador del navegador que pidio. Es lo que permite repartir turnos
  // entre personas que no tienen sesion: sin el, cualquiera podria pedir veinte
  // seguidas y todas irian antes que la primera de los demas.
  dispositivoId String?
  // Como se muestra en la pantalla. Sale de la sesion si la hay.
  nombre String?

  // Numero de pedido de QUIEN pide: 1 la primera que pidio, 2 la segunda...
  // YA NO ORDENA LA FILA, que va por orden de llegada; se guarda porque dice
  // cuantas llevaba pedidas esa persona, que es util para mirar el historial.
  turno Int @default(1)

  estado   EstadoPedidoMusica @default(EN_FILA)
  creadoEn DateTime           @default(now())
  sonoEn   DateTime?

  @@index([estado, creadoEn])
  @@index([cancionId, estado])
  @@index([claseId])
}
