# ---------------------------------------------------------------------------
# Base de datos (Postgres). En Railway se inyecta automaticamente al enlazar
# el plugin de Postgres al servicio; usa la referencia ${{Postgres.DATABASE_URL}}
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solicitud_clases?schema=public"

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Secreto para firmar los JWT. En produccion usa un valor largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Vigencia de los tokens
JWT_EXPIRES_ADMIN="12h"
JWT_EXPIRES_CLIENTE="90d"

# Origenes permitidos para CORS, separados por coma.
# Solo hace falta si despliegas client y server como servicios separados.
CORS_ORIGINS="http://localhost:5173"

# URL publica de la app (se usa para armar los links de las reservas y el .ics)
APP_URL="http://localhost:5173"

# Zona horaria del gimnasio. Colombia no tiene horario de verano (UTC-5 fijo).
TZ_GIMNASIO="America/Bogota"

# ---------------------------------------------------------------------------
# Credenciales del administrador que crea el seed
# ---------------------------------------------------------------------------
ADMIN_TELEFONO="3001234567"
ADMIN_PASSWORD="admin123"
ADMIN_NOMBRE="Administrador"

# ---------------------------------------------------------------------------
# Frontend (Vite). Solo necesario si el client se despliega aparte del server.
# Si se deja vacio, el cliente asume que la API vive en el mismo origen (/api).
# ---------------------------------------------------------------------------
VITE_API_URL=""
